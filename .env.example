# ===================================================
# YASIN LAPTOP HUB — ENVIRONMENT CONFIGURATION TEMPLATE
# Do NOT place real production secrets in this file.
# Copy to .env in each corresponding workspace before starting.
# ===================================================

# BACKEND ENVIRONMENT VARIABLES (backend/.env)
PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/yasin-laptop-hub?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,https://yasinlaptophub.com

# CLOUDINARY MEDIA STORAGE (backend/.env)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# FRONTEND ENVIRONMENT VARIABLES (frontend/.env.local)
NEXT_PUBLIC_SITE_URL=https://yasinlaptophub.com
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_WHATSAPP_NUMBER=+923000000000

# ADMIN ENVIRONMENT VARIABLES (admin/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SITE_URL=https://yasinlaptophub.com
